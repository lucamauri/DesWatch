{
  "name": "deswatch",
  "displayName": "DesWatch",
  "description": "Design token intelligence for VS Code — first-class editing support for DESIGN.md files",
  "version": "0.2.0",
  "publisher": "lucamauri",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Visualization"
  ],
  "keywords": [
    "design tokens",
    "design system",
    "DESIGN.md",
    "color",
    "CSS"
  ],
  "homepage": "https://github.com/lucamauri/DesWatch",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucamauri/DesWatch.git"
  },
  "bugs": {
    "url": "https://github.com/lucamauri/DesWatch/issues"
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "deswatch.exportCssVariables",
        "title": "DesWatch: Export CSS Custom Properties"
      },
      {
        "command": "deswatch.exportTailwindConfig",
        "title": "DesWatch: Export Tailwind Config"
      }
    ],
    "languages": [
      {
        "id": "design-md",
        "aliases": [
          "Design MD",
          "design-md"
        ],
        "filenamePatterns": [
          "*design*.md",
          "*DESIGN*.md"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "design-md",
        "scopeName": "source.design-md",
        "path": "./syntaxes/design-md.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.yaml": "yaml"
        }
      }
    ],
    "snippets": [
      {
        "language": "design-md",
        "path": "./snippets/design-md.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deswatch",
          "title": "DesWatch",
          "icon": "images/icon.png"
        }
      ]
    },
    "views": {
      "deswatch": [
        {
          "id": "deswatch.preview",
          "name": "Design Preview",
          "type": "webview",
          "icon": "images/icon.png"
        }
      ]
    },
    "configuration": {
      "title": "DesWatch",
      "properties": {
        "deswatch.sectionValidation": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "off"
          ],
          "default": "warning",
          "markdownDescription": "Severity of diagnostics for missing or out-of-order Markdown sections in DESIGN.md files. Token-level errors (malformed hex values, wrong types) are always reported as errors regardless of this setting."
        },
        "deswatch.draftThreshold": {
          "type": "number",
          "default": 3,
          "markdownDescription": "Minimum number of `##` sections before DesWatch reports missing canonical sections. Files with fewer sections are treated as drafts and the missing-section Hints are suppressed."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "test": "vscode-test",
    "build-icon": "node scripts/build-icon.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.41",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.0",
    "mocha": "^10.8.2",
    "sharp": "^0.34.5",
    "typescript": "^5.4.0"
  }
}
